{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gnauhuhsaij/structured-output-reliability/schemas/case.schema.json",
  "title": "Generated structured-output case record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_schema_version",
    "case_id",
    "generator",
    "family",
    "messages",
    "json_schema",
    "expected",
    "comparison",
    "prompt_length",
    "expected_output_length",
    "expected_field_count",
    "expected_field_paths"
  ],
  "properties": {
    "case_schema_version": {
      "const": "1.0.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^case_[0-9a-f]{16}$"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "seed"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "integer"
        }
      }
    },
    "family": {
      "enum": [
        "flat_object",
        "nested_object",
        "array_object",
        "mixed_types"
      ]
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "enum": [
              "system",
              "user"
            ]
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "json_schema": {
      "oneOf": [
        {
          "type": "object"
        },
        {
          "type": "boolean"
        }
      ]
    },
    "expected": {},
    "comparison": {
      "$ref": "#/$defs/comparisonPolicy"
    },
    "prompt_length": {
      "$ref": "#/$defs/lengthRecord"
    },
    "expected_output_length": {
      "$ref": "#/$defs/lengthRecord"
    },
    "expected_field_count": {
      "type": "integer",
      "minimum": 1
    },
    "expected_field_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/jsonPointer"
      }
    }
  },
  "$defs": {
    "comparisonPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numeric",
        "absolute_tolerance",
        "relative_tolerance",
        "arrays"
      ],
      "properties": {
        "numeric": {
          "enum": [
            "exact",
            "absolute_tolerance",
            "relative_tolerance"
          ]
        },
        "absolute_tolerance": {
          "type": "number",
          "minimum": 0
        },
        "relative_tolerance": {
          "type": "number",
          "minimum": 0
        },
        "arrays": {
          "const": "ordered"
        }
      }
    },
    "lengthRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "actual",
        "unit",
        "exact"
      ],
      "properties": {
        "target": {
          "type": "integer",
          "minimum": 1
        },
        "actual": {
          "type": "integer",
          "minimum": 0
        },
        "unit": {
          "enum": [
            "tokens",
            "characters"
          ]
        },
        "exact": {
          "type": "boolean"
        }
      }
    },
    "jsonPointer": {
      "type": "string",
      "pattern": "^(?:|(?:/(?:[^~/]|~0|~1)*)+)$"
    }
  }
}
