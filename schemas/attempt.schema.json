{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gnauhuhsaij/structured-output-reliability/schemas/attempt.schema.json",
  "title": "Terminal model attempt record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attempt_schema_version",
    "run_id",
    "condition_id",
    "case_id",
    "attempt_id",
    "repeat_id",
    "phase",
    "sequence_index",
    "terminal",
    "started_at",
    "finished_at",
    "request",
    "response",
    "timing",
    "tokens",
    "score",
    "error",
    "diagnostics"
  ],
  "properties": {
    "attempt_schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{12}Z_[0-9a-f]{12}$"
    },
    "condition_id": {
      "type": "string",
      "pattern": "^cond_[0-9a-f]{16}$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^case_[0-9a-f]{16}$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^attempt_[0-9a-f]{16}$"
    },
    "repeat_id": {
      "type": "integer",
      "minimum": 0
    },
    "phase": {
      "enum": [
        "warmup",
        "measure"
      ]
    },
    "sequence_index": {
      "type": "integer",
      "minimum": 0
    },
    "terminal": {
      "const": true
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "request": {
      "$ref": "#/$defs/request"
    },
    "response": {
      "$ref": "#/$defs/response"
    },
    "timing": {
      "$ref": "#/$defs/timing"
    },
    "tokens": {
      "$ref": "#/$defs/tokens"
    },
    "score": {
      "$ref": "#/$defs/score"
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/error"
        }
      ]
    },
    "diagnostics": {
      "type": "object"
    }
  },
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "url",
        "body_sha256",
        "body",
        "seed_sent",
        "structured_constraint_sent"
      ],
      "properties": {
        "method": {
          "const": "POST"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "body_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "body": {
          "type": "object"
        },
        "seed_sent": {
          "type": "boolean"
        },
        "structured_constraint_sent": {
          "type": "boolean"
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "http_status",
        "protocol_valid",
        "content",
        "finish_reason",
        "refusal",
        "refusal_detected",
        "truncated",
        "response_bytes",
        "raw_chunk_count",
        "stream_terminated_normally",
        "raw_response",
        "stream_events"
      ],
      "properties": {
        "http_status": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 100,
          "maximum": 599
        },
        "protocol_valid": {
          "type": "boolean"
        },
        "content": {
          "type": [
            "string",
            "null"
          ]
        },
        "finish_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "refusal": {
          "type": [
            "string",
            "null"
          ]
        },
        "refusal_detected": {
          "type": "boolean"
        },
        "truncated": {
          "type": "boolean"
        },
        "response_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "raw_chunk_count": {
          "type": "integer",
          "minimum": 0
        },
        "stream_terminated_normally": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "raw_response": {},
        "stream_events": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/streamEvent"
              }
            }
          ]
        }
      }
    },
    "streamEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arrival_offset_ns",
        "event",
        "data"
      ],
      "properties": {
        "arrival_offset_ns": {
          "type": "integer",
          "minimum": 0
        },
        "event": {
          "type": [
            "string",
            "null"
          ]
        },
        "data": {}
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_queue_ns",
        "observed_duration_ns",
        "e2e_latency_ns",
        "ttft_ns",
        "tpot_ns"
      ],
      "properties": {
        "client_queue_ns": {
          "type": "integer",
          "minimum": 0
        },
        "observed_duration_ns": {
          "type": "integer",
          "minimum": 0
        },
        "e2e_latency_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "ttft_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "tpot_ns": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "output",
        "total",
        "token_count_source",
        "tokenizer"
      ],
      "properties": {
        "input": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "token_count_source": {
          "enum": [
            "server",
            "local_tokenizer",
            "unavailable"
          ]
        },
        "tokenizer": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_success",
        "json_parsed",
        "parsed_json",
        "schema_valid",
        "exact_correct",
        "correct_fields",
        "total_fields",
        "parse_error",
        "schema_errors",
        "comparison_errors",
        "primary_outcome"
      ],
      "properties": {
        "request_success": {
          "type": "boolean"
        },
        "json_parsed": {
          "type": "boolean"
        },
        "parsed_json": {},
        "schema_valid": {
          "type": "boolean"
        },
        "exact_correct": {
          "type": "boolean"
        },
        "correct_fields": {
          "type": "integer",
          "minimum": 0
        },
        "total_fields": {
          "type": "integer",
          "minimum": 1
        },
        "parse_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "schema_errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scoreError"
          }
        },
        "comparison_errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scoreError"
          }
        },
        "primary_outcome": {
          "enum": [
            "cancelled",
            "timeout",
            "transport_error",
            "http_error",
            "protocol_error",
            "empty_content",
            "invalid_json",
            "schema_invalid",
            "field_incorrect",
            "exact_correct"
          ]
        }
      }
    },
    "scoreError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "message"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "type",
        "message",
        "retriable"
      ],
      "properties": {
        "stage": {
          "enum": [
            "transport",
            "timeout",
            "http",
            "protocol",
            "stream",
            "cancelled",
            "internal"
          ]
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "retriable": {
          "type": "boolean"
        }
      }
    }
  }
}
